# ─────────────────────────────────────────────────────────────
#  Confluent Cloud – Bootstrap
# ─────────────────────────────────────────────────────────────
CONFLUENT_CLOUD_API_KEY=<your-cloud-api-key>
CONFLUENT_CLOUD_API_SECRET=<your-cloud-api-secret>

# ─────────────────────────────────────────────────────────────
#  Confluent Cloud – Environment & Cluster
# ─────────────────────────────────────────────────────────────
CONFLUENT_ENV_ID=env-xxxxxx
CONFLUENT_CLUSTER_ID=lkc-xxxxxx
CONFLUENT_BOOTSTRAP=pkc-xxxxxx.region.provider.confluent.cloud:9092

# ─────────────────────────────────────────────────────────────
#  Schema Registry
# ─────────────────────────────────────────────────────────────
SCHEMA_REGISTRY_URL=https://psrc-xxxxxx.region.provider.confluent.cloud
SCHEMA_REGISTRY_API_KEY=<your-sr-api-key>
SCHEMA_REGISTRY_API_SECRET=<your-sr-api-secret>

# ─────────────────────────────────────────────────────────────
#  Service Account – Writer (CDC connector + Flink)
# ─────────────────────────────────────────────────────────────
WRITER_SA_ID=sa-xxxxxx
WRITER_API_KEY=<writer-api-key>
WRITER_API_SECRET=<writer-api-secret>

# ─────────────────────────────────────────────────────────────
#  Service Account – Reader (consumers, dashboards)
# ─────────────────────────────────────────────────────────────
READER_SA_ID=sa-yyyyyy
READER_API_KEY=<reader-api-key>
READER_API_SECRET=<reader-api-secret>

# ─────────────────────────────────────────────────────────────
#  PostgreSQL (local Docker)
# ─────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=payments
POSTGRES_USER=payments_user
POSTGRES_PASSWORD=<your-postgres-password>
